# GEMINI_API_KEY: Optional Gemini API key if AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
VITE_SITE_URL=""

# Local SQLite path for development; use a Neon PostgreSQL URL on Vercel
DATABASE_URL="file:./magestic.db"

# Stable signing key (at least 32 random characters; configure in Vercel)
AUTH_SECRET=""

# Admin authentication (leave ADMIN_PASSWORD empty on first run to claim via /admin UI, or set in Secrets)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# WhatsApp business number in international format without + (e.g. 919161876789)
VITE_WHATSAPP_NUMBER="919161876789"

# Email notification settings (logs to console if unset)
RESEND_API_KEY=""
NOTIFY_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional Cloudflare Turnstile spam protection
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Vercel Blob read-write token (configure in Vercel for persistent uploads)
BLOB_READ_WRITE_TOKEN=""
